# Copiar a .env.local para desarrollo local (nunca commitear .env.local).
# En Vercel: Project Settings → Environment Variables.

# API key de Resend (resend.com/api-keys), usada por src/app/api/contact/route.ts
# para mandar el mail de notificación de nuevas consultas y la confirmación
# automática al cliente.
RESEND_API_KEY=
